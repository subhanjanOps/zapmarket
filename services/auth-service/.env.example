# Auth Service Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=zapuser
DB_PASSWORD=zappass123
DB_NAME=userauth

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=7

# OAuth2 - Google
OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH2_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback

# OAuth2 - Facebook
OAUTH2_FACEBOOK_CLIENT_ID=your-facebook-client-id
OAUTH2_FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
OAUTH2_FACEBOOK_REDIRECT_URL=http://localhost:8080/auth/oauth/facebook/callback

# Service Configuration
HTTP_PORT=8080
GRPC_PORT=50051
APP_ENV=development

# Email — Resend (preferred). Leave empty to fall back to SMTP or log-only.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Email — SMTP fallback (used if RESEND_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zapmarket.com

# Password reset link base URL
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# OTP settings
OTP_EXPIRY_MINUTES=10

# Twilio SMS for phone OTP. Leave empty to log OTPs instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
