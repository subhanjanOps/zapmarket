HTTP_PORT=8000
APP_ENV=development

# Gateway dedicated database
DB_HOST=localhost
DB_PORT=5432
DB_USER=zapuser
DB_PASSWORD=zappass123
DB_NAME=apigateway

# Redis (required — rate limiting + service registry)
REDIS_URL=localhost:6379

# Auth service
AUTH_SERVICE_ADDR=localhost:50051
AUTH_SERVICE_HTTP_URL=http://localhost:8080

# Downstream service HTTP fallback URLs (used when Redis registry has no entries)
CATALOG_SERVICE_HTTP_URL=http://localhost:8081
ORDER_SERVICE_HTTP_URL=http://localhost:8084

# Auto-bind: gateway watches service manifests and auto-registers routes.
# Default: true in development, false in production.
GATEWAY_AUTO_BIND=true
