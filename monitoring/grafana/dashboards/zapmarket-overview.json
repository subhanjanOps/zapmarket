{
  "uid": "zapmarket-overview",
  "title": "ZapMarket — Service Overview",
  "tags": ["zapmarket"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
        "query": "label_values(up, job)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service Health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services Up",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job=~\"$service\"} == 1)",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services Down",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job=~\"$service\"} == 0) or vector(0)",
          "legendFormat": "down"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Service Status",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 8, "y": 1, "w": 16, "h": 4 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "up{job=~\"$service\"}",
          "legendFormat": "{{job}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true }, "renameByName": { "job": "Service", "Value": "Status" } } }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "HTTP Traffic",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request Rate (req/s) by Service",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(job) (rate({__name__=~\".+_http_requests_total\",job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Rate by Service",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(job) (rate({__name__=~\".+_errors_total\",job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP Requests by Method & Status — All Services",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(job, method, status) (rate({__name__=~\".+_http_requests_total\",job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}} {{method}} {{status}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Domain Operations",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Domain Ops Rate by Service",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(job, op, result) (rate({__name__=~\".+_domain_ops_total\",job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}} / {{op}} / {{result}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "piechart",
      "title": "Domain Op Results (success vs failure)",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "sum by(result) (increase({__name__=~\".+_domain_ops_total\",job=~\"$service\"}[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Currency Service",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "FX Rate Ingestion (success / failure)",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(currency_ingest_total[2m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "FX Provider Fetch Duration (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(currency_provider_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(currency_provider_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(currency_provider_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Redis Cache Hit vs Miss Rate",
      "datasource": { "type": "prometheus", "uid": "zapmarket-prometheus" },
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(currency_cache_hits_total[2m])",
          "legendFormat": "hits"
        },
        {
          "expr": "rate(currency_cache_misses_total[2m])",
          "legendFormat": "misses"
        }
      ]
    }
  ]
}
